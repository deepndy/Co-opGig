# Copy to .env for Docker Compose. Use unique local development values.
POSTGRES_USER=coopgig
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=coopgig
JWT_SECRET=replace-with-a-random-32-character-or-longer-local-secret
FRONTEND_ORIGIN=http://localhost:8080

# Optional local Hardhat integration. Leave contract address blank until deployed.
BLOCKCHAIN_RPC_URL=http://host.docker.internal:8545
BLOCKCHAIN_CHAIN_ID=31337
COOPGIG_REGISTRY_ADDRESS=
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
