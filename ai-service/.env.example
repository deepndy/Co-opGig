# Every value is optional: the defaults below already work. Never put real secrets in this example file.
# The service does not read ".env" by itself. Export these variables in your shell,
# or pass the file to Docker with:  docker run --env-file .env ...
# Keep comments on their own lines (Docker does not strip comments after a value).

# --- model / decisions (starting points, not scientific guarantees) ---
AI_MODEL_VERSION=baseline-tfidf-lr-keywords-0.1.0
# Below this confidence the bot asks a clarifying question.
CONFIDENCE_THRESHOLD=0.60
# If the top two categories are closer than this, ask.
MARGIN_THRESHOLD=0.15
# Stricter margin for appliance-repair vs technician.
PAIR_MARGIN_THRESHOLD=0.40
# Below this the bot says it cannot tell and asks for a description.
UNKNOWN_BELOW=0.30

# --- input limits ---
MAX_TEXT_CHARS=1000
MAX_BODY_BYTES=16384
REQUEST_TIMEOUT_SECONDS=15

# --- data retention (sessions live in memory only, never on disk) ---
# A conversation is forgotten after this many minutes of inactivity.
SESSION_TTL_MINUTES=30
MAX_SESSIONS=5000

# --- network ---
# Leave empty in production. For local frontend development only, e.g. http://localhost:3000
CORS_ORIGINS=

# --- optional generative provider (NOT implemented in this version) ---
LLM_PROVIDER=none
