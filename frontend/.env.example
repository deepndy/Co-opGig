# Co-opGig frontend environment variables
# Copy to .env (never commit the real file).

# Base origin of the core backend API (no trailing slash, no /api/v1 suffix).
# Leave empty to call the same origin. Example: https://api.coopgig.example
VITE_API_BASE_URL=http://localhost:4000

# true  = clearly-labelled local demo using synthetic browser data (no backend)
# false = call the core backend endpoints from the shared API contract
VITE_USE_MOCK_API=true

# Request timeout in milliseconds (optional)
VITE_API_TIMEOUT_MS=12000
